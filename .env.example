# Copy to .env next to docker-compose.yml.
DOMAIN=game-master.online
PUBLIC_URL=https://game-master.online
DB_PASSWORD=change-me
SECURE_COOKIES=1
TZ_DISPLAY=Europe/Moscow
# Folder with google-service-account.json, google-oauth-client.json, telegram-bot-token, telegram-host-bot-token,
# claude-oauth-token (the assistant on the admin's Claude subscription: output of `claude setup-token`)
SECRETS_DIR=./secrets
# Optional: ANTHROPIC_API_KEY=... (assistant without a subscription), OPENAI_API_KEY=...
